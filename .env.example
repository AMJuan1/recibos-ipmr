# Contraseña del panel /admin (obligatoria)
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión (openssl rand -hex 32). Si falta, las sesiones se cierran al reiniciar.
SESSION_SECRET=
# Carpeta donde vive recibos.db (en Render: el disco persistente, p. ej. /var/data)
DATA_DIR=./data
# Ejecutable de Python para el extractor de planillas (por defecto python/python3 del sistema)
PYTHON=

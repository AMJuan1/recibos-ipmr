# Contraseña del panel /admin (obligatoria)
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión (openssl rand -hex 32). Si falta, las sesiones se cierran al reiniciar.
SESSION_SECRET=
# Carpeta donde vive recibos.db (en Render: el disco persistente, p. ej. /var/data)
DATA_DIR=./data
# Extracción automática de planillas con Claude
ANTHROPIC_API_KEY=
# Correo saliente (Gmail: smtp.gmail.com, puerto 465, contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=juantony794@gmail.com
